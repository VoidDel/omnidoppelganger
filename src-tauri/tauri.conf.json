{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniDoppelganger",
  "version": "0.8.5",
  "identifier": "com.omnidoppelganger.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniDoppelganger",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "hardenedRuntime": true,
      "signingIdentity": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0NDE0NDUwNTU0NzQ0NEYKUldSUFJFZFZVRVJCVkxyWGhXalRBMmU1V083ZUU5cHAzbFhaMUthaU03SkRQQkRWMkVkK2ZUeWUK",
      "endpoints": [
        "https://github.com/VoidDel/omnidoppelganger/releases/latest/download/latest.json"
      ]
    }
  }
}
